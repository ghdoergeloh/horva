{
  "name": "@horva/transactional",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "tsc",
    "preview": "email dev --dir src/templates --port 3001",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "nodemailer": "catalog:",
    "react": "catalog:react19",
    "react-email": "catalog:"
  },
  "devDependencies": {
    "@horva/tsconfig": "workspace:*",
    "@horva/vitest": "workspace:*",
    "@react-email/ui": "catalog:",
    "@types/node": "catalog:",
    "@types/nodemailer": "catalog:",
    "@types/react": "catalog:react19",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
