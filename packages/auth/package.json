{
  "name": "@repo/auth",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./auth": "./src/auth.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "generate": "dotenv -e ../../.env -- auth generate --config src/auth.ts --output ../db/src/schema/auth-schema.ts --yes",
    "lint": "eslint",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@repo/prettier-config",
  "dependencies": {
    "@repo/db": "workspace:*",
    "@repo/transactional": "workspace:*",
    "better-auth": "catalog:"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@repo/tsconfig": "workspace:*",
    "@repo/vitest": "workspace:*",
    "auth": "catalog:",
    "eslint": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:react19",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:react19"
  }
}
