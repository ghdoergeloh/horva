{
  "name": "@horva/electron-app",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "clean": "git clean -xdf .cache .turbo out node_modules",
    "dev": "electron-vite dev",
    "postinstall": "install-electron",
    "pack": "electron-vite build && electron-builder",
    "start": "electron-vite preview",
    "test:e2e": "playwright test",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false -p tsconfig.node.json && tsc --noEmit --emitDeclarationOnly false -p tsconfig.web.json"
  },
  "dependencies": {
    "@horva/react": "workspace:*",
    "@orpc/client": "catalog:",
    "@orpc/server": "catalog:",
    "dotenv": "catalog:",
    "i18next": "catalog:",
    "react-i18next": "catalog:"
  },
  "devDependencies": {
    "@electron-toolkit/utils": "catalog:",
    "@horva/contract": "workspace:*",
    "@horva/core": "workspace:*",
    "@horva/db": "workspace:*",
    "@horva/tsconfig": "workspace:*",
    "@horva/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "electron-vite": "catalog:",
    "jsdom": "catalog:",
    "react": "catalog:react19",
    "react-dom": "catalog:react19",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
