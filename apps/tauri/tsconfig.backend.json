{
  "extends": "@horva/tsconfig/base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "tsBuildInfoFile": "${configDir}/.cache/tsbuildinfo.backend.json"
  },
  "include": [
    "src/backend/**/*",
    "src/shared/**/*",
    "src/webview/brand-assets.spec.ts",
    "vite.config.ts",
    "vite.backend.config.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "e2e/**/*",
    "scripts/**/*"
  ]
}
