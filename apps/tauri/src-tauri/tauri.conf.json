{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Horva",
  "version": "../package.json",
  "identifier": "de.ghdoergeloh.horva",
  "build": {
    "beforeDevCommand": "pnpm run prepare:sidecar && pnpm run build:backend && pnpm run dev:webview",
    "devUrl": "http://localhost:5174",
    "beforeBuildCommand": "pnpm run prepare:sidecar && pnpm run build",
    "frontendDist": "../dist/webview"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Horva",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "nsis", "appimage"],
    "category": "Productivity",
    "copyright": "Copyright © 2026",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/node"],
    "resources": { "../dist/backend/": "backend/" }
  }
}
