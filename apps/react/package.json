{
  "name": "@horva/react",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/globals.css"
  },
  "scripts": {
    "build": "tsc -b && vite build",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "vite",
    "preview": "vite preview",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@dnd-kit/core": "catalog:",
    "@dnd-kit/sortable": "catalog:",
    "@dnd-kit/utilities": "catalog:",
    "@horva/auth": "workspace:*",
    "@horva/contract": "workspace:*",
    "@horva/ui": "workspace:*",
    "@internationalized/date": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "i18next": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:react19",
    "react-aria-components": "catalog:",
    "react-dom": "catalog:react19",
    "react-i18next": "catalog:",
    "rrule": "catalog:"
  },
  "devDependencies": {
    "@horva/tailwind-config": "workspace:*",
    "@horva/tsconfig": "workspace:*",
    "@horva/vitest": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/router-plugin": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "@vitejs/plugin-react": "catalog:",
    "jsdom": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
