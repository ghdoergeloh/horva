{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "extends": ["../../.oxlintrc.json", "../../tooling/eslint/oxlint-react.json"],
  "ignorePatterns": ["**/*.config.*", "**/routeTree.gen.ts"],
  "overrides": [
    {
      "files": ["**/*.{js,ts,tsx}"],
      "excludeFiles": ["**/env.ts"],
      "rules": {
        "no-restricted-properties": [
          "error",
          {
            "object": "process",
            "property": "env",
            "message": "Use `import { env } from '~/env'` instead to ensure validated types."
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "name": "process",
            "importNames": ["env"],
            "message": "Use `import { env } from '~/env'` instead to ensure validated types."
          }
        ]
      }
    },
    {
      "files": ["src/routes/**"],
      "rules": {
        "react/only-export-components": "off"
      }
    }
  ]
}
