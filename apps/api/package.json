{
  "name": "@horva/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "dotenv -e ../../.env -- tsx watch src/index.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test:unit": "vitest run",
    "test:unit:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "with-env": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@horva/auth": "workspace:*",
    "@horva/contract": "workspace:*",
    "@horva/core": "workspace:*",
    "@horva/db": "workspace:*",
    "@horva/transactional": "workspace:*",
    "@orpc/server": "catalog:",
    "hono": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@horva/tsconfig": "workspace:*",
    "@horva/vitest": "workspace:*",
    "@types/node": "catalog:",
    "esbuild": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
