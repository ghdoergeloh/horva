{
  "name": "@horva/cli",
  "version": "0.0.1",
  "bin": {
    "horva": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "node build.mjs --watch",
    "pack": "node build.mjs && cd dist && pnpm pack --pack-destination ..",
    "test:unit": "vitest run --passWithNoTests",
    "test:unit:coverage": "vitest run --coverage --passWithNoTests",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@horva/core": "workspace:*",
    "@horva/db": "workspace:*",
    "@inquirer/prompts": "catalog:",
    "chalk": "catalog:",
    "commander": "catalog:",
    "dotenv": "catalog:",
    "pg": "catalog:"
  },
  "devDependencies": {
    "@horva/tsconfig": "workspace:*",
    "@horva/vitest": "workspace:*",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
