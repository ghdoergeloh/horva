{
  "name": "@horva/root",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "crap": "node tooling/quality/crap-score.mjs",
    "db:generate": "turbo -F @horva/db generate",
    "db:migrate": "turbo -F @horva/db migrate",
    "db:push": "turbo -F @horva/db push",
    "db:studio": "turbo -F @horva/db studio",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "dev": "turbo watch dev --continue",
    "format": "turbo run format --continue -- --cache --cache-location .cache/.prettiercache",
    "format:fix": "turbo run format --continue -- --write --cache --cache-location .cache/.prettiercache",
    "postinstall": "pnpm lint:ws",
    "knip": "DATABASE_URL=postgresql://knip:knip@localhost:5432/knip knip",
    "lint": "turbo run lint --continue -- --cache --cache-location .cache/.eslintcache",
    "lint:fix": "turbo run lint --continue -- --fix --cache --cache-location .cache/.eslintcache",
    "lint:ws": "pnpm dlx sherif@latest",
    "prepare": "husky",
    "preview:emails": "pnpm -F @horva/transactional preview",
    "test": "vitest --passWithNoTests",
    "test:e2e": "turbo run test:e2e",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "typecheck": "turbo run typecheck"
  },
  "prettier": "@horva/prettier-config",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@horva/prettier-config": "workspace:*",
    "@turbo/gen": "^2.10.13",
    "dependency-cruiser": "^18.3.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "knip": "^6.35.1",
    "lint-staged": "^17.5.1",
    "prettier": "catalog:",
    "turbo": "^2.10.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": "^24.13.0",
    "pnpm": "^11.16.0"
  }
}
