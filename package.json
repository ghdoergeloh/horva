{
  "name": "@horva/root",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "git clean -xdf node_modules",
    "clean:workspaces": "turbo run clean",
    "crap": "node tooling/quality/crap-score.mjs",
    "db:generate": "pnpm -F @horva/db generate",
    "db:migrate": "pnpm -F @horva/db migrate",
    "db:push": "pnpm -F @horva/db push",
    "db:studio": "pnpm -F @horva/db studio",
    "depcruise": "depcruise apps packages --config .dependency-cruiser.cjs",
    "dev": "turbo watch dev --continue",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "knip": "knip",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "lint:ws": "sherif",
    "postinstall": "pnpm lint:ws",
    "prepare": "husky",
    "preview:emails": "pnpm -F @horva/transactional preview",
    "storybook": "pnpm -F @horva/ui storybook",
    "test": "vitest",
    "test:e2e": "turbo run test:e2e",
    "test:unit": "turbo run test:unit",
    "test:unit:coverage": "turbo run test:unit:coverage",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@turbo/gen": "catalog:",
    "dependency-cruiser": "catalog:",
    "dotenv-cli": "catalog:",
    "eslint-plugin-sonarjs": "catalog:",
    "eslint-plugin-turbo": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^24.21.0",
    "pnpm": "^12.5.1"
  },
  "packageManager": "pnpm@12.5.1"
}
