{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    // Generated by @tanstack/router-plugin; not meant to be hand-curated.
    "**/routeTree.gen.ts",
  ],
  "workspaces": {
    ".": {
      // Loaded by `turbo gen` (plop-style), not imported by any source file.
      "entry": ["turbo/generators/config.ts"],
    },
    "apps/electron": {
      // `orpc` (the tanstack-query utils bridge) and the `initOrpc` it depends
      // on are unused by any current component - every call site still talks
      // to the API via raw `client.x()` calls. Kept as the documented,
      // eventual `@orpc/tanstack-query` entry point (see the Architecture
      // section of the README) rather than deleted and re-added later.
      "entry": ["src/renderer/src/lib/orpc.ts"],
    },
    "apps/web": {
      // apps/web/src/overrides/*.{ts,tsx} are swapped in via Vite resolve.alias
      // (see vite.config.ts) for two files that would otherwise resolve to
      // apps/electron's shared renderer source — invisible to static import
      // analysis, so they need to be declared as entry points explicitly.
      "entry": ["src/overrides/*.{ts,tsx}"],
      // apps/web reuses apps/electron's renderer source wholesale via the `~`
      // alias (see vite.config.ts); these dependencies are only ever imported
      // from files that physically live in apps/electron, so knip can't
      // attribute the usage to this workspace's own package.json.
      "ignoreDependencies": [
        "@dnd-kit/core",
        "@dnd-kit/sortable",
        "@dnd-kit/utilities",
        "@tanstack/react-query",
        "rrule",
        "@horva/tailwind-config",
        "@internationalized/date",
        "lucide-react",
        "react-aria-components",
        "tailwindcss",
      ],
    },
    "packages/db": {
      // The Drizzle plugin would execute drizzle.config.ts, which needs
      // DATABASE_URL. The config is read by drizzle-kit, not imported.
      "drizzle": false,
      "entry": ["drizzle.config.ts"],
    },
    "tooling/prettier": {
      // Referenced by name in index.js's `plugins` array, not imported.
      "ignoreDependencies": ["prettier-plugin-packagejson"],
    },
    "tooling/tailwind": {
      // Referenced by name in postcss-config.js's `plugins` object, not imported.
      "ignoreDependencies": ["@tailwindcss/postcss"],
    },
    "tooling/eslint": {
      // Enabled via the "typescript" string in base.js's import/resolver
      // setting (eslint-import-resolver-* convention), not imported directly.
      "ignoreDependencies": ["eslint-import-resolver-typescript"],
    },
  },
}
