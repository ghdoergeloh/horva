{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      // Loaded by `turbo gen` (plop-style), not imported by any source file.
      "entry": ["turbo/generators/config.ts"],
    },
    "apps/react": {
      // `orpc` (the tanstack-query utils bridge) is unused by any current
      // component - every call site still talks to the API via raw
      // `client.x()` calls. Kept as the documented, eventual
      // `@orpc/tanstack-query` entry point rather than deleted and re-added.
      "entry": ["src/lib/orpc.ts"],
    },
    "packages/db": {
      // The Drizzle plugin would execute drizzle.config.ts, which needs
      // DATABASE_URL. The config is read by drizzle-kit, not imported.
      "drizzle": false,
      "entry": ["drizzle.config.ts"],
    },
    "tooling/tailwind": {
      // Referenced by name in postcss-config.js's `plugins` object, not imported.
      "ignoreDependencies": ["@tailwindcss/postcss"],
    },
  },
}
