# =============================================================================
# DEVCONTAINER config — remote Docker host, workspace on a named volume.
#
# Inside the workspace container the infra is reached by its compose SERVICE NAME
# on the internal port (postgres:5432, mailpit:1025), never via localhost: the
# egress firewall blocks the Docker host and its network by design.
#
# Only addresses and clone settings belong here — no secrets. The repo-root `.env`
# (created inside the volume from `.env.example` by bootstrap-workspace.sh) holds
# credentials and general config; the values here are injected into the container
# environment by compose and take precedence for the variables they define.
#
# This file is committed on purpose. Adjust WORKSPACE_REPO_URL before first start.
# =============================================================================

# --- Workspace bootstrap (see bootstrap-workspace.sh) ------------------------
# /workspace is an empty named volume on the remote host on first create; the
# sources are cloned from here. Use an HTTPS URL — the firewall allows the public
# internet, and no SSH agent is forwarded into the container.
# For private repos use a token URL, e.g.
#   https://<user>:<token>@github.com/<org>/<repo>.git
WORKSPACE_REPO_URL=https://github.com/ghdoergeloh/mono-repo-template.git
# Branch or tag to check out. Empty = the remote's default branch.
WORKSPACE_REPO_REF=main

# --- Infra addresses ---------------------------------------------------------
# Database — the app only ever reads DATABASE_URL.
# Keep user/password/db in sync with POSTGRES_* used by compose.yml.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/template

# SMTP (Mailpit) — shares the workspace's network namespace, hence localhost.
# The inbox UI is on localhost:8025 (forwarded by VS Code).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM=noreply@localhost

# --- Dev server binding ------------------------------------------------------
# Dev servers must listen on 0.0.0.0 inside the container so VS Code's port
# forwarding can reach them. Vite honours HOST; @hono/node-server honours HOSTNAME.
HOST=0.0.0.0
HOSTNAME=0.0.0.0
API_PORT=3000

# The frontend runs in the LOCAL browser and reaches the API through the forwarded
# tunnel port, so localhost is correct here (not the compose service name).
VITE_API_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
