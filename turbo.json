{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalDependencies": [
    ".env",
    "pnpm-lock.yaml",
    "pnpm-workspace.yaml",
    "tsconfig.json",
    "tooling/**/*.json",
    "tooling/**/*.js"
  ],
  "tasks": {
    "topo": {
      "dependsOn": ["^topo"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "out/**", ".cache/tsbuildinfo*.json"]
    },
    "dev": {
      "dependsOn": ["^dev"],
      "cache": false,
      "persistent": false
    },
    "typecheck": {
      "dependsOn": ["^topo"],
      "outputs": [".cache/tsbuildinfo*.json"]
    },
    "pack": {
      "dependsOn": ["build"],
      "cache": false
    },
    "test:unit": {
      "dependsOn": ["^topo"],
      "outputs": []
    },
    "test:unit:coverage": {
      "dependsOn": ["^topo"],
      "outputs": ["coverage/**"]
    },
    "clean": {
      "cache": false
    },
    "//#clean": {
      "cache": false
    },
    "test:e2e": {
      "dependsOn": ["^topo"],
      "cache": false,
      "env": [
        "E2E_ADMIN_DATABASE_URL",
        "E2E_DATABASE",
        "E2E_WEB_PORT",
        "E2E_API_PORT"
      ]
    }
  },
  "globalEnv": [
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "MIGRATIONS_DIR",
    "XDG_CONFIG_HOME",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "TRUSTED_ORIGINS",
    "API_PORT",
    "API_PROXY_TARGET",
    "SPA_DIR",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_SECURE",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM"
  ],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "npm_lifecycle_event",
    "NODE_EXTRA_CA_CERTS",
    "NODE_USE_ENV_PROXY",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "no_proxy"
  ]
}
